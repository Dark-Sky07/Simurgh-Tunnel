#!/usr/bin/env python3
"""simurgh -- launcher for a system-installed Simurgh Tunnel.

`install.sh` uses a virtualenv because it also builds the compiled engine from
a checkout; a .deb/.rpm/.tar.gz has no virtualenv, so this launcher points the
interpreter at the directory the package installed the modules into.  The
package build substitutes @LIBDIR@; `$SIMURGH_LIB` overrides it (that is how a
portable tree unpacked somewhere else than / is run), and `sys.prefix` is the
last resort so a plain `make install` into a custom prefix works too.
"""

import os
import sys

NAME = "simurgh"
BUILT_LIBDIR = "@LIBDIR@"


def libdir() -> str:
    candidates = [os.environ.get("SIMURGH_LIB", ""), BUILT_LIBDIR,
                  os.path.join(sys.prefix, "lib", NAME)]
    for candidate in candidates:
        if candidate and os.path.isdir(candidate):
            return candidate
    return BUILT_LIBDIR


LIBDIR = libdir()
if LIBDIR not in sys.path:
    sys.path.insert(0, LIBDIR)

from simurgh.cli import main  # noqa: E402  (needs the path above)

if __name__ == "__main__":
    sys.exit(main())
