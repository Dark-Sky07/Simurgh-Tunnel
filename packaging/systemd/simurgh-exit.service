[Unit]
Description=Simurgh Tunnel (exit: this machine listens for the Iranian relay)
Documentation=https://github.com/Dark-Sky07/Simurgh-Tunnel/blob/main/docs/PACKAGING.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SIMURGH_HOME=/etc/simurgh
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/simurgh exit
Restart=always
RestartSec=3
LimitNOFILE=1048576
TimeoutStopSec=15
KillMode=mixed
# An exit holds one session per user connection it forwards; the ceiling is
# generous on purpose, and MemoryHigh starts reclaiming before the hard cap.
MemoryHigh=1G
MemoryMax=2G
TasksMax=8192
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
